# --- CONFIGURACIÓN DEL SERVIDOR ---
PORT=3000
NODE_ENV="development" # development, production, test
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL="debug"

# --- BASE DE DATOS (MySQL) ---
# Formato: mysql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL="mysql://root:password@localhost:3306/my_database"

# --- SEGURIDAD Y AUTENTICACIÓN ---
# Genera una clave segura (ej: openssl rand -base64 32)
JWT_SECRET="your_super_secret_key_here"
JWT_EXPIRES_IN="7d"
CSRF_ORIGIN_CHECK_ENABLED=false
FRONTEND_URL="http://localhost:5173"

# --- EMAIL / RECUPERACION DE CONTRASENA ---
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your_smtp_user"
EMAIL_PASS="your_smtp_password"
EMAIL_FROM="TrackMyExpenses <noreply@trackmyexpenses.com>"

# --- SERVICIOS EXTERNOS ---
# Obtén tu llave en: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
EXCHANGE_RATE_API_KEY="your-exchange-rate-api-key"
EXCHANGE_RATE_API_URL="https://v6.exchangerate-api.com/v6"


# --- CACHE Y RENDIMIENTO (Redis) ---
REDIS_URL="redis://localhost:6379"
CACHE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_TTL=60

# --- ARCHIVOS ---
UPLOADS_DIR="./uploads/users"
