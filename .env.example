# Docker Compose variables
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=trackmyexpenses
MYSQL_PORT=3306

FRONTEND_PORT=5173
VITE_API_URL=http://localhost:3000/api
VITE_ASSETS_URL=http://localhost:3000
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_CONTACT_EMAIL=support@trackmyexpenses.dev

# Backend container startup
PRISMA_MIGRATE_DEPLOY=true

# Backend DATABASE_URL examples
# Use localhost when the backend runs on your host machine against the MySQL container.
# DATABASE_URL=mysql://root:change-me@localhost:3306/trackmyexpenses
#
# Use mysql when another container joins the same Docker Compose network.
# DATABASE_URL=mysql://root:change-me@mysql:3306/trackmyexpenses
